NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images
# Local: http://localhost:3000. On Render: your real https URL (used for sitemap/SEO).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional spam check (Cloudflare Turnstile, free). Set BOTH to turn it on; the site key is baked in at build time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Added by the free-tier hardening. Everything below is OPTIONAL; the defaults are safe. ----

# Affiliate redirects (/go) only go to approved merchant domains (a built-in list of Amazon, Flipkart, Myntra, Ajio, Meesho, Nykaa ...
# plus affiliate networks). Add more stores here, comma separated; subdomains are included automatically.
#   enforce = refuse unknown domains (default)   warn = allow but log   off = only block dangerous URLs
AFFILIATE_HOST_POLICY=enforce
AFFILIATE_EXTRA_HOSTS=

# Seconds an affiliate URL is remembered in memory before being re-read from the database (default 300, minimum 5).
# Admin saves clear it immediately; this only bounds staleness if you ever run more than one server instance.
LINK_CACHE_TTL_SEC=300

# Set to 1 ONLY when your domain is proxied through Cloudflare (orange cloud). Rate limits then use the real visitor IP
# from Cloudflare's CF-Connecting-IP header instead of X-Forwarded-For.
TRUST_CF_CONNECTING_IP=0

# Also keep the untouched original of every admin image upload in Storage (off by default: Supabase Free has only 1 GB).
KEEP_ORIGINALS=0
